h TTA (augmentations: flips, rotations).\"\"\"\n","    img = tf.keras.utils.load_img(img_path, target_size=(IMG_SIZE, IMG_SIZE))\n","    img_array = tf.keras.utils.img_to_array(img)\n","    img_input = preprocess_fn(np.expand_dims(img_array, axis=0))\n","\n","    # Base prediction\n","    probs = model.predict(img_input, verbose=0)[0]\n","\n","    # Augmentations\n","    datagen = ImageDataGenerator(\n","        rotation_range=10,\n","        horizontal_flip=True,\n","        vertical_flip=False,\n","        zoom_range=0.05\n","    )\n","    # Generate augmented versions and average\n","    aug_probs = []\n","    for _ in range(n_aug):\n","        aug_img = datagen.random_transform(img_array)\n","        aug_input = preprocess_fn(np.expand_dims(aug_img, axis=0))\n","        aug_probs.append(model.predict(aug_input, verbose=0)[0])\n","    # Average\n","    avg_probs = np.mean(aug_probs, axis=0)\n","    # Combine with original: 0.5 * original + 0.5 * average_aug\n","    final_probs = 0.5 * probs + 0.5 * avg_probs\n","    return final_probs\n","\n","# Evaluate TTA on test set (sample or full)\n","from tqdm import tqdm\n","\n","y_tta_pred = []\n","for img_path in tqdm(test_df['filename'].values[:100]):   # just first 100 for demo\n","    probs = predict_with_tta(model, img_path, preprocess_input, n_aug=3)\n","    y_tta_pred.append(np.argmax(probs))\n","\n","acc_tta = np.mean(np.array(y_tta_pred) == y_true[:100])\n","print(f\"TTA Accuracy (first 100 samples): {acc_tta:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pEanQ0zzjHW8","executionInfo":{"status":"ok","timestamp":1785356715670,"user_tz":-240,"elapsed":59548,"user":{"displayName":"Ali Al Sulaimani","userId":"14637414350812725391"}},"outputId":"0d00aa69-25ea-4b56-be78-3554a8c0c9ae"},"execution_count":63,"outputs":[{"output_type":"stream","name":"stderr","text":["100%|██████████| 100/100 [00:59<00:00,  1.68it/s]"]},{"output_type":"stream","name":"stdout","text":["TTA Accuracy (first 100 sa