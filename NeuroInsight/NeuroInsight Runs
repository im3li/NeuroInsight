"        return eff_preprocess\n","    elif \"mobilenet\" in model_name:\n","        return mobile_preprocess\n","    elif \"resnet\" in model_name:\n","        return resnet_preprocess\n","    else:\n","        return lambda x: x / 255.0\n","\n","def create_generator(df, model_name, batch_size=BATCH_SIZE, shuffle=True):\n","    preprocess_fn = get_preprocessing_fn(model_name)\n","    datagen = keras.preprocessing.image.ImageDataGenerator(preprocessing_function=preprocess_fn)\n","    generator = datagen.flow_from_dataframe(\n","        dataframe=df,\n","        x_col='img_path',\n","        y_col='class_name',          # now a string column\n","        target_size=(IMG_SIZE, IMG_SIZE),\n","        batch_size=batch_size,\n","        class_mode='categorical',\n","        classes=CLASSES,             # ensures consistent ordering\n","        shuffle=shuffle\n","    )\n","    return generator\n","\n","# -----------------------------\n","# Model creation\n","# -----------------------------\n","def create_model(model_name, num_classes=NUM_CLASSES):\n","    input_tensor = keras.Input(shape=(IMG_SIZE, IMG_SIZE, 3))\n","    if model_name == \"baseline_efficientnet\":\n","        base = EfficientNetB0(include_top=False, weights='imagenet', input_tensor=input_tensor)\n","    elif model_name == \"mobilenet\":\n","        base = MobileNetV3Large(include_top=False, weights='imagenet', input_tensor=input_tensor)\n","    elif model_name == \"resnet50\":\n","        base = ResNet50(include_top=False, weights='imagenet', input_tensor=input_tensor)\n","    else:\n","        raise ValueError(f\"Unknown model: {model_name}\")\n","\n","    base.trainable = False  # freeze base initially\n","    x = layers.GlobalAveragePooling2D()(base.output)\n","    x = layers.Dropout(0.3)(x)\n","    x = layers.Dense(128, activation='relu')(x)\n","    x = layers.Dropout(0.3)(x)\n","    outputs = layers.Dense(num_classes, activation='softmax')(x)\n","    model = keras.Model(inputs=input_tensor, outputs=outputs)\n","    return model\n","\n","# -----------------------------\n","# Drive backup callback (fixed location)\n","# -----------------------------\n","def make_drive_backup_callback(ckpt_path, model_name, every_n_epochs=5):\n","    drive_dir = \"/content/drive/MyDrive/saved_models_v3_backup\"\n","    class DriveBackup(tf.keras.callbacks.Callback):\n","        def on_epoch_end(self, epoch, logs=None):\n","            if (epoch + 1) % every_n_epochs == 0:\n","                try:\n","                    os.makedirs(drive_dir, exist_ok=True)\n","                    if os.path.exists(ckpt_path):\n","                        shutil.copy(ckpt_path, os.path.join(drive_dir, f\"{model_name}.keras\"))\n","                        print(f\"Backup completed: {model_name}\")\n","                except Exception as e:\n","                    print(\"Backup error:\", e)\n","    return DriveBackup()\n","\n","# -----------------------------\n","# Training function\n","# -----------------------------\n","def train_model(model_name, train_df, val_df, epochs=EPOCHS):\n","    print(f\"\\n===== Training {model_name} =====\")\n","    model = create_model(model_name)\n","    model.compile(optimizer='adam',\n","                  loss='categorical_crossentropy',\n","                  metrics=['accuracy'])\n","\n","    train_gen = create_generator(train_df, model_name, shuffle=True)\n","    val_gen = create_generator(val_df, model_name, shuffle=False)\n","\n","    # Callbacks\n","    checkpoint_path = os.path.join(MODELS_DIR, f\"{model_name}.keras\")\n","    checkpoint = ModelCheckpoint(checkpoint_path, save_best_only=True, monitor='val_loss', mode='min')\n","    early_stop = EarlyStopping(patience=10, restore_best_weights=True)\n","    drive_backup = make_drive_backup_callback(checkpoint_path, model_name, every_n_epochs=5)\n","\n","    history = model.fit(\n","        train_gen,\n","        steps_per_epoch=len(train_gen),\n","        validation_data=val_gen,\n","        validation_steps=len(val_gen),\n","        epochs=epochs,\n","        callbacks=[checkpoint, early_stop, drive_backup]\n","    )\n","\n","    # Load best weights\n","    model.load_weights(checkpoint_path)\n","    return model, history\n","\n","# -----------------------------\n","# Evaluation & reporting\n","# -----------------------------\n","def generate_report(pred_class, confidence, img_path, save_dir=MODELS_DIR):\n","    report_path = os.path.join(save_dir, f\"report_{os.path.basename(img_path)}.txt\")\n","    with open(report_path, 'w') as f:\n","        f.write(f\"Image: {img_path}\\n\")\n","        f.write(f\"Predicted class: {pred_class}\\n\")\n","        f.write(f\"Confidence: {confidence*100:.2f}%\\n\")\n","    print(f\"Report saved: {report_path}\")\n","\n","def evaluate_model(model_name, test_df):\n","    print(f\"\\n===== Evaluating {model_name} =====\")\n","    model = keras.models.load_model(os.path.join(MODELS_DIR, f\"{model_name}.keras\"))\n","    test_gen = create_generator(test_df, model_name, shuffle=False)\n","    y_true = test_gen.classes   # these are integer indices corresponding to CLASSES order\n","    y_pred_probs = model.predict(test_gen)\n","    y_pred = np.argmax(y_pred_probs, axis=1)\n","\n","    print(classification_report(y_true, y_pred, target_names=CLASSES))\n","    cm = confusion_matrix(y_true, y_pred)\n","    print(\"Confusion Matrix:\\n\", cm)\n","    return model, y_pred, y_pred_probs\n","\n","# -----------------------------\n","# Grad-CAM (FIXED)\n","# -----------------------------\n","def run_gradcam(model_name=\"baseline_efficientnet\", num_samples_per_class=1):\n","    print(f\"\\n===== STEP 8: Generating Grad-CAM Explanation for {model_name} =====\")\n","    model = keras.models.load_model(os.path.join(MODELS_DIR, f\"{model_name}.keras\"))\n","    preprocess_fn = get_preprocessing_fn(model_name)\n","\n","    # Automatically find last conv layer\n","    def find_last_conv_layer(model):\n","        for layer in reversed(model.layers):\n","            try:\n","                if len(layer.output.shape) == 4:\n","                    print(\"Grad-CAM layer selected:\", layer.name, layer.output.shape)\n","                    return layer.name\n","            except:\n","                pass\n","        raise Exception(\"No convolution layer found\")\n","\n","    last_conv_layer_name = find_last_conv_layer(model)\n","    grad_model = tf.keras.models.Model(\n","        inputs=model.inputs,\n","        outputs=[model.get_layer(last_conv_layer_name).output, model.output]\n","    )\n","\n","    test_df = pd.read_csv(TEST_CSV)  # reload to get filenames (use the same loading logic if needed)\n","    # Ensure we have class_name for later use, but we only need filenames and true labels\n","    # We'll rely on the CSV columns; assume 'label' is integer or string.\n","    if 'label' in test_df.columns:\n","        # If label is string, map; else keep as is for sampling by class\n","        if test_df['label'].dtype == object:\n","            label_col = 'label'\n","        else:\n","            # convert integer to string class name for grouping\n","            test_df['label_str'] = test_df['label'].apply(lambda x: CLASSES[x])\n","            label_col = 'label_str'\n","    else:\n","        raise ValueError(\"CSV must contain a 'label' column\")\n","\n","    for cls_idx, target_class in enumerate(CLASSES):\n","        print(f\"\\n--- Generating Grad-CAM for class: {target_class} ---\")\n","        # Filter by the class name (string) or integer\n","        if test_df['label'].dtype == object:\n","            samples = test_df[test_df['label'] == target_class].sample(\n","                min(num_samples_per_class, len(test_df[test_df['label']==target_class])),\n","                random_state=42\n","            )\n","        else:\n","            # label is integer, use index\n","            samples = test_df[test_df['label'] == cls_idx].sample(\n","                min(num_samples_per_class, len(test_df[test_df['label']==cls_idx])),\n","                random_state=42\n","            )\n","        for _, row in samples.iterrows():\n","            img_path = row['filename']  # relative path; adjust if needed\n","            label = row['label'] if test_df['label'].dtype == object else CLASSES[row['label']]\n","\n","            # Load and preprocess image\n","            img = tf.keras.utils.load_img(img_path, target_size=(IMG_SIZE, IMG_SIZE))\n","            img_array = tf.keras.utils.img_to_array(img)\n","            img_input = preprocess_fn(np.expand_dims(img_array, axis=0))\n","\n","            # Grad-CAM\n","            with tf.GradientTape() as tape:\n","                conv_outputs, predictions = grad_model(img_input)\n","                pred_index = tf.argmax(predictions[0])\n","                loss = predictions[:, pred_index]\n","\n","            gradients = tape.gradient(loss, conv_outputs)\n","            pooled_grads = tf.reduce_mean(gradients, axis=(0,1,2))\n","            conv_outputs = conv_outputs[0]\n","            heatmap = tf.reduce_sum(conv_outputs * pooled_grads, axis=-1)\n","            heatmap = tf.maximum(heatmap, 0)\n","            heatmap /= (tf.reduce_max(heatmap) + tf.keras.backend.epsilon())\n","\n","            # CRITICAL FIX: convert to numpy array properly\n","            heatmap = np.array(heatmap)\n","            if heatmap.ndim != 2:\n","                print(\"Invalid heatmap:\", heatmap.shape)\n","                continue\n","\n","            # Overlay\n","            img_raw = cv2.imread(img_path)\n","            if img_raw is None:\n","                print(f\"Could not read image: {img_path}\")\n","                continue\n","            img_raw = cv2.resize(img_raw, (IMG_SIZE, IMG_SIZE))\n","            heatmap = cv2.resize(heatmap, (IMG_SIZE, IMG_SIZE))\n","            heatmap = np.uint8(255 * heatmap)\n","            heatmap_colored = cv2.applyColorMap(heatmap, cv2.COLORMAP_JET)\n","            superimposed = cv2.addWeighted(img_raw, 0.6, heatmap_colored, 0.4, 0)\n","\n","            predicted_class = CLASSES[int(pred_index)]\n","            confidence = float(predictions[0][pred_index])\n","            filename = os.path.basename(img_path)\n","            save_path = os.path.join(MODELS_DIR, f\"gradcam_{model_name}_{filename}.png\")\n","\n","            # Plot and save\n","            plt.figure(figsize=(10,5))\n","            plt.subplot(1,2,1)\n","            plt.imshow(cv2.cvtColor(img_raw, cv2.COLOR_BGR2RGB))\n","            plt.title(f\"Original: {label}\")\n","            plt.axis(\"off\")\n","            plt.subplot(1,2,2)\n","            plt.imshow(cv2.cvtColor(superimposed, cv2.COLOR_BGR2RGB))\n","            plt.title(f\"{predicted_class}\\n{confidence*100:.2f}%\")\n","            plt.axis(\"off\")\n","            plt.savefig(save_path, bbox_inches=\"tight\")\n","            plt.close()\n","            print(f\"Grad-CAM saved: {save_path}\")\n","\n","            generate_report(predicted_class, confidence, img_path, save_dir=MODELS_DIR)\n","\n","# -----------------------------\n","# Backup all outputs to Drive\n","# -----------------------------\n","def backup_all_outputs():\n","    backup_dir = \"/content/drive/MyDrive/saved_models_v3_backup\"\n","    os.makedirs(backup_dir, exist_ok=True)\n","    for file in os.listdir(MODELS_DIR):\n","        src = os.path.join(MODELS_DIR, file)\n","        dst = os.path.join(backup_dir, file)\n","        if os.path.isfile(src):\n","            shutil.copy2(src, dst)\n","    print(\"All outputs backed up to Drive:\")\n","    print(backup_dir)\n","\n","# -----------------------------\n","# Main execution\n","# -----------------------------\n","if __name__ == \"__main__\":\n","    # Load data (adjust img_dir if needed)\n","    train_df = load_data_from_csv(TRAIN_CSV)\n","    val_df   = load_data_from_csv(VAL_CSV)\n","    test_df  = load_data_from_csv(TEST_CSV)\n","\n","    # Uncomment to train models from scratch\n","    # train_model(\"baseline_efficientnet\", train_df, val_df)\n","    # train_model(\"mobilenet\", train_df, val_df)\n","    # train_model(\"resnet50\", train_df, val_df)\n","\n","    # Evaluate all models\n","    print(\"===== EVALUATING EFFICIENTNET =====\")\n","    evaluate_model(\"baseline_efficientnet\", test_df)\n","    print(\"\\n===== EVALUATING MOBILENET =====\")\n","    evaluate_model(\"mobilenet\", test_df)\n","    print(\"\\n===== EVALUATING RESNET50 =====\")\n","    evaluate_model(\"resnet50\", test_df)\n","\n","    # Generate Grad-CAM explanations (with fixed implementation)\n","    run_gradcam(model_name=\"baseline_efficientnet\", num_samples_per_class=2)\n","    run_gradcam(model_name=\"mobilenet\", num_samples_per_class=2)\n","    run_gradcam(model_name=\"resnet50\", num_samples_per_class=2)\n","\n","    # Backup everything to Drive\n","    backup_all_outputs()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_qYJ7PKYU81k","executionInfo":{"status":"ok","timestamp":1785345085302,"user_tz":-240,"elapsed":59,"user":{"displayName":"Ali Al Sulaimani","userId":"14637414350812725391"}},"outputId":"639516e9-86e9-4877-e318-1821b21b3c44"},"execution_count":38,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting /content/NeuroInsight/pipeline.py\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"138375e8","executionInfo":{"status":"ok","timestamp":1785345201778,"user_tz":-240,"elapsed":106380,"user":{"displayName":"Ali Al Sulaimani","userId":"14637414350812725391"}},"outputId":"8fe6802f-cd24-436f-ee57-7635637d715a"},"source":["%run pipeline.py"],"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["===== EVALUATING EFFICIENTNET =====\n","\n","===== Evaluating baseline_efficientnet =====\n","Found 2924 validated image filenames belonging to 4 classes.\n","\u001b[1m92/92\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m25s\u001b[0m 167ms/step\n","             