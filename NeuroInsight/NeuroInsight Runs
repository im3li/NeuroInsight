ansform(img_array)\n","        aug_input = preprocess_fn(np.expand_dims(aug_img, axis=0))\n","        aug_probs.append(model.predict(aug_input, verbose=0)[0])\n","\n","    # Average augmented probabilities\n","    avg_aug_probs = np.mean(aug_probs, axis=0)\n","    # Combine with original (50% weight each)\n","    final_probs = 0.5 * orig_probs + 0.5 * avg_aug_probs\n","    return final_probs\n","\n","# ---- Run TTA on all test images ----\n","print(\"Running TTA on the full test set...\")\n","print(f\"Total test samples: {len(test_df)}\")\n","print(\"This will take ~15-25 minutes (with n_aug=5).\")\n","print(\"Progress:\")\n","\n","y_tta = []\n","y_true = test_df['label'].values   # these are strings, map to integer indices\n","# Map string labels to indices (e.g., 'ModerateDemented' -> 0)\n","label_to_idx = {cls: i for i, cls in enumerate(NEW_CLASSES)}\n","y_true_idx = np.array([label_to_idx[l] for l in y_true])\n","\n","for idx, row in tqdm(test_df.iterrows(), total=len(test_df)):\n","    img_path = row['filename']\n","    probs = predict_with_tta(model, img_path, n_aug=5, preprocess_fn=preprocess_input)\n","    pred = np.argmax(probs)\n","    y_tta.append(pred)\n","\n","y_tta = np.array(y_tta)\n","\n","# ---- Evaluate ----\n","acc_tta = np.mean(y_tta == y_true_idx)\n","print(\"\\n\" + \"=\"*60)\n","print(f\"✅ TTA Accuracy: {acc_tta:.4f} ({acc_tta*100:.2f}%)\")\n","print(\"=\"*60)\n","\n","# Classification report\n","print(\"\\nClassification Report (with TTA):\")\n","print(classification_report(y_true_idx, y_tta, target_names=NEW_CLASSES))\n","\n","# Confusion matrix\n","cm_tta = confusion_matrix(y_true_idx, y_tta)\n","print(\"\\nConfusion Matrix (with TTA):\")\n","print(cm_tta)\n","\n","# Compare with original (non-TTA) accuracy\n","# Assuming you still have y_pred_adjusted (or compute again)\n","try:\n","    acc_orig = np.mean(y_true_idx == y_pred_adjusted)\n","    print(f\"\\nOriginal accuracy (without TTA): {acc_orig:.4f}\")\n","    print(f\"Improvement: {acc