===========\n","\n","import numpy as np\n","import tensorflow as tf\n","import matplotlib.pyplot as plt\n","import cv2\n","import os\n","\n","# Ensure constants are defined\n","IMG_SIZE = 224\n","NEW_CLASSES = ['ModerateDemented', 'NonDemented', 'EarlyDemented']\n","\n","# Load your fine‑tuned model\n","model = tf.keras.models.load_model(\"saved_models_3class/resnet50_finetuned.keras\")\n","last_conv_name = \"conv5_block3_out\"   # ResNet50's last conv layer\n","\n","# Pick 3 test images (one per class)\n","test_sample = test_df.groupby('label').sample(n=1, random_state=42)\n","img_paths = test_sample['filename'].values\n","true_labels = test_sample['label'].values\n","\n","def preprocess_image(img_path):\n","    img = tf.keras.utils.load_img(img_path, target_size=(IMG_SIZE, IMG_SIZE))\n","    img_array = tf.keras.utils.img_to_array(img)\n","    return preprocess_input(img_array), img_array\n","\n","def guided_gradcam(model, img_input_batch, pred_index, last_conv_name):\n","    \"\"\"\n","    Returns:\n","      - Grad‑CAM heatmap (2D)\n","      - Vanilla input gradient (positive, 2D)\n","      - Guided Grad‑CAM (2D)\n","    All maps are normalized to [0,1].\n","    \"\"\"\n","    # Convert to tensor and watch it\n","    input_tensor = tf.convert_to_tensor(img_input_batch, dtype=tf.float32)\n","\n","    # ---------- Grad‑CAM ----------\n","    with tf.GradientTape() as tape:\n","        tape.watch(input_tensor)\n","        grad_model = tf.keras.models.Model(\n","            inputs=model.input,\n","            outputs=[model.get_layer(last_conv_name).output, model.output]\n","        )\n","        conv_outputs, predictions = grad_model(input_tensor)\n","        loss = predictions[:, pred_index]\n","    grads = tape.gradient(loss, conv_outputs)\n","    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))\n","    conv_outputs = conv_outputs[0]\n","    heatmap = tf.reduce_sum(conv_outputs * pooled_grads, axis=-1)\n","    heatmap = tf.maximum(heatmap, 0)\n","    heatmap /= (tf.reduce_max(heatmap) + 1e-8)\n","    heatmap_np = heatmap.numpy()\n","\n","    # ---------- Input Gradient (positive part) ----------\n","    with tf.GradientTape() as tape2:\n","        tape2.watch(input_tensor)\n","        predictions2 = model(input_tensor)\n","        loss2 = predictions2[:, pred_index]\n","    grads_input = tape2.gradient(loss2, input_tensor)[0]\n","    guided_grad = tf.maximum(grads_input, 0)          # ReLU\n","    guided_grad_2d = tf.reduce_mean(guided_grad, axis=-1).numpy()\n","    # Normalise\n","    guided_grad_2d = (guided_grad_2d - guided_grad_2d.min()) / (guided_grad_2d.max() - guided_grad_2d.min() + 1e-8)\n","\n","    # ---------- Guided Grad‑CAM ----------\n","    heatmap_resized = cv2.resize(heatmap_np, (IMG_SIZE, IMG_SIZE))\n","    guided_gcam = guided_grad_2d * heatmap_resized\n","    guided_gcam = (guided_gcam - guided_gcam.min()) / (guided_gcam.max() - guided_gcam.min() + 1e-8)\n","\n","    return heatmap_np, guided_grad_2d, guided_gcam\n","\n","def overlay_heatmap(img_bgr, heatmap, alpha=0.6):\n","    hm = cv2.resize(heatmap, (IMG_SIZE, IMG_SIZE))\n","    hm = np.uint8(255 * hm)\n","    hm_colored = cv2.applyColorMap(hm, cv2.COLORMAP_JET)\n","    return cv2.addWeighted(img_bgr.astype(np.uint8), alpha, hm_colored, 1 - alpha, 0)\n","\n","# Process each image\n","for idx, img_path in enumerate(img_paths):\n","    print(f\"\\nProcessing {os.path.basename(img_path)} ...\")\n","    img_pp, img_orig = preprocess_image(img_path)\n","    x = np.expand_dims(img_pp, axis=0)   # shape (1,224,224,3)\n","\n","    # Get prediction\n","    probs = model.predict(x, verbose=0)[0]\n","    pred_idx = np.argmax(probs)\n","    pred_class = NEW_CLASSES[pred_idx]\n","    conf = probs[pred_idx]\n","\n","    # Generate maps\n","    heatmap, vanilla_grad, guided_gcam = guided_gradcam(\n","        model, x, pred_idx, last_conv_name\n","    )\n","\n","    # Convert original image to BGR for OpenCV\n","    img_bgr = cv2.cvtColor(img_orig.astype(np.uint8